aws_region  = "us-east-1"
name        = "opcenter-dev"
project     = "opcenter-rds"
vpc_cidr    = "172.0.0.0/16"
db_username = "sqladmin"

# Passwords are generated by Terraform and stored in AWS Secrets Manager by default.
# Set db_password or ad_password only if you must bring your own password.
opcenter_db_username = "opcenter"
opcenter_db_name     = "opcenter"

# Optional S3-to-FSx seed copy.
# s3_seed_bucket_name  = "my-opcenter-seed-bucket"
# s3_seed_prefix       = "metadata"
# fsx_share_name       = "share"
# fsx_seed_subdirectory = "metadata"
